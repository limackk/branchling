{
  "name": "branchling",
  "version": "0.1.0",
  "description": "A backlog that lives in markdown files and is driven from the terminal: one task is one file with YAML frontmatter, and every index, view and aggregate is computed from those files rather than committed.",
  "keywords": [
    "backlog",
    "task-management",
    "markdown",
    "cli",
    "issue-tracker",
    "project-management",
    "yaml-frontmatter",
    "git",
    "todo",
    "kanban"
  ],
  "homepage": "https://github.com/limackk/branchling#readme",
  "bugs": "https://github.com/limackk/branchling/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limackk/branchling.git"
  },
  "license": "MIT",
  "author": "Kamil Kwiatkowski",
  "type": "module",
  "bin": {
    "branchling": "bin/branchling.mjs"
  },
  "files": [
    "bin/",
    "scripts/",
    ".agents/skills/backlog-workflow/",
    "examples/agent-adapters/",
    "!scripts/tests/",
    "!scripts/check-publish-metadata.mjs",
    "templates/",
    "_template.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test scripts/tests/*.test.mjs",
    "prepublishOnly": "node scripts/check-publish-metadata.mjs"
  }
}
